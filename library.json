{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "iown-homecontrol",
  "version": "0.7.0",
  "description": "io-homecontrol protocol library for Somfy, Velux and compatible devices, targeting ESP32 boards with RadioLib-supported radios.",
  "keywords": "io-homecontrol, somfy, velux, LoRa32, iown, iohome",
  "homepage": "https://github.com/thoscut/iown-homecontrol",
  "license": "CC-BY-SA-4.0",
  "platforms": "espressif32",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoscut/iown-homecontrol"
  },
  "authors": [
    {
      "name": "Velocet",
      "email": "git@mail.velocet.de",
      "url": "https://velocet.github.io/",
      "maintainer": true
    }
  ],
  "dependencies": [
    {
      "name": "RadioLib",
      "version": "7.7.1"
    }
  ],
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "examples": [
    "examples/*/*.ino"
  ],
  "build": {
    "libLDFMode": "deep+"
  }
}
